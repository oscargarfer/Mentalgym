{
  "appId": "com.oscargarcia.gimnasiomental",
  "appName": "Gimnasio Mental",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#f5f4f1",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#f5f4f1",
      "showSpinner": false,
      "launchAutoHide": true,
      "launchShowDuration": 400,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f5f4f1",
      "overlaysWebView": false
    }
  }
}
